rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Public read for elephants registry, write for registry updates & cascade delete
    match /elephants/{elephantId} {
      allow read: if true;
      allow write: if true;
    }

    // Diagnostics test writes for connection health checking
    match /diagnostics/{diagnosticId} {
      allow read: if true;
      allow write: if true;
    }

    // Community user-submitted elephant posts & admin moderation
    match /elephant_posts/{postId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Cultural events and notices
    match /cultural_events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    // User profiles and followed elephants list
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Real-time visitor presence tracking
    match /visitors/{visitorId} {
      allow read, write: if true;
    }
  }
}
