rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Public read for elephants registry, public write for registry updates & follow counters
    match /elephants/{elephantId} {
      allow read: if true;
      allow write: if true;
    }

    // Community user-submitted elephant posts
    match /elephant_posts/{postId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Cultural events and notices
    match /cultural_events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    // User profiles and followed elephants
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
